<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DashBen — Today"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_counts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open DashBen to sync"
        android:textColor="#c9ccd6"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <TextView android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#e8e9ee" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#e8e9ee" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/w_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#e8e9ee" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/w_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#e8e9ee" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/w_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#e8e9ee" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/w_row6" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#e8e9ee" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:ellipsize="end" />

    <TextView
        android:id="@+id/w_family"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#c9ccd6"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_weather"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#c9ccd6"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#6b7180"
        android:textSize="10sp"
        android:layout_marginTop="4dp" />
</LinearLayout>
