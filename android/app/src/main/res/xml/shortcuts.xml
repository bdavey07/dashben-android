<?xml version="1.0" encoding="utf-8"?>
<!-- App shortcuts (stamp eu): long-press the DashBen icon. Each opens
     MainActivity with the same dashben_action extra the widgets use. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="capture" android:enabled="true" android:icon="@drawable/ic_shortcut_capture" android:shortcutShortLabel="@string/shortcut_capture_short" android:shortcutLongLabel="@string/shortcut_capture_long">
        <intent android:action="ca.bendavey.pkm.WIDGET" android:targetPackage="ca.bendavey.pkm" android:targetClass="ca.bendavey.pkm.MainActivity">
            <extra android:name="dashben_action" android:value="capture" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="task" android:enabled="true" android:icon="@drawable/ic_shortcut_task" android:shortcutShortLabel="@string/shortcut_task_short" android:shortcutLongLabel="@string/shortcut_task_long">
        <intent android:action="ca.bendavey.pkm.WIDGET" android:targetPackage="ca.bendavey.pkm" android:targetClass="ca.bendavey.pkm.MainActivity">
            <extra android:name="dashben_action" android:value="task" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="note" android:enabled="true" android:icon="@drawable/ic_shortcut_note" android:shortcutShortLabel="@string/shortcut_note_short" android:shortcutLongLabel="@string/shortcut_note_long">
        <intent android:action="ca.bendavey.pkm.WIDGET" android:targetPackage="ca.bendavey.pkm" android:targetClass="ca.bendavey.pkm.MainActivity">
            <extra android:name="dashben_action" android:value="note" />
        </intent>
    </shortcut>
</shortcuts>
