    <color name="widget_bg_bottom">@android:color/system_neutral1_900</color>
    <color name="widget_stroke">@android:color/system_neutral2_700</color>
    <color name="widget_btn">@android:color/system_accent2_800</color>
    <color name="widget_btn_stroke">@android:color/system_accent2_700</color>
    <color name="widget_text">@android:color/system_neutral1_50</color>
    <color name="widget_muted">@android:color/system_neutral2_300</color>
    <color name="widget_muted2">@android:color/system_neutral2_200</color>
    <color name="widget_accent">@android:color/system_accent1_200</color>
